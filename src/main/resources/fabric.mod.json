{
  "schemaVersion": 1,
  "id": "minecraft_ai_agent",
  "version": "${version}",
  "name": "Minecraft AI Agent",
  "description": "A server-enabled Minecraft AI agent with live server logs, chat history, NPC and mob tools for Minecraft 1.20.1.",
  "authors": ["Mortylovelly"],
  "contact": {
    "sources": "https://github.com/Mortylovelly/Minecraft-AI-Agent"
  },
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "minecraft_ai_agent.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.mortylovelly.minecraftai.MinecraftAiAgent"
    ],
    "client": [
      "com.mortylovelly.minecraftai.client.MinecraftAiAgentClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.11+1.20.1"
